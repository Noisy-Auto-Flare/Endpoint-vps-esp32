# Скопируй этот файл в .env и заполни своими значениями:
#   cp .env.example .env

# Ключ Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIza...

# Придуманный тобой секретный ключ - его будут слать ESP32-CAM и microReader
# в заголовке X-Device-Key, чтобы посторонние не смогли дёргать твой сервер
DEVICE_KEY=придумай-длинную-случайную-строку

# Модель Gemini (поддерживает текст/фото/аудио на вход)
GEMINI_MODEL=gemini-3.5-flash-lite

# --- STT (распознавание речи) ---
# Тумблер: GROQ_STT_ENABLED=false (по умолчанию) = аудио напрямую в отвечающую модель Gemini.
# true = голос -> Groq Whisper (текст) -> Gemini. При падении Groq — автоматический fallback на прямое аудио.
# Ключ Groq (бесплатный тариф): https://console.groq.com/keys
# Если оставить пустым при enabled=true — работает прямой путь (аудио сразу в Gemini).
GROQ_STT_ENABLED=false
GROQ_API_KEY=
# Модель Whisper у Groq: whisper-large-v3 (точнее) или whisper-large-v3-turbo (быстрее)
GROQ_STT_MODEL=whisper-large-v3
# Язык распознавания (ru/en/...)
GROQ_STT_LANGUAGE=ru
# Переопределение системных промптов (необязательно, по умолчанию встроенные):
# VOICE_AUDIO_PROMPT="..."
# VOICE_TRANSCRIPT_PROMPT="..."
# PHOTO_SYSTEM_PROMPT="..."

# Порт, на котором слушает сервер.
# Можно поменять здесь (через .env), ЛИБО передать при запуске: python3 app.py --port 8090
# Флаг --port имеет приоритет над этим значением.
# В systemd-юните gunicorn биндится на этот же порт: --bind 0.0.0.0:$PORT ($PORT из EnvironmentFile).
PORT=8080

# --- Лимиты сервера (активные env-knob'ы, указаны дефолты из app.py) ---
VOICE_MAX_CHUNKS=20
# Отдельный лимит для режима записи урока (2000 * 5 сек ≈ 2.7 часа); VOICE_MAX_CHUNKS — для режима qa.
LESSON_MAX_CHUNKS=2000
VOICE_SESSION_TTL=600
VOICE_MAX_SESSIONS=50
PHOTO_MAX_BYTES=2097152
VOICE_MAX_BYTES=2097152
MAX_CONTENT_LENGTH=8388608
PHOTO_FRAME_MAX_BYTES=2097152
PHOTOS_MAX_IMAGES=10
PHOTOS_MAX_TOTAL_B64=6291456
VOICE_CHUNK_MAX_BYTES=1048576
PHOTO_STAGING_CAP=20
PHOTO_BYTES_CAP=12582912
PHOTO_STAGING_TTL=1800
# Кап длины ответа (символов): пост-обрезка в set_latest_result с маркером "…".
# Защищает 2MB LittleFS microReader и транзиентный пик ESP8266 getString (ответ+копия).
MAX_ANSWER_CHARS=8000
# Прошивка ESP32-C3: MAX_SECONDS=7200 (2 ч) на одну запись; в режиме qa сервер дополнительно режет сессию VOICE_MAX_CHUNKS=20 чанками (~100 с), в режиме урока — LESSON_MAX_CHUNKS=2000.
